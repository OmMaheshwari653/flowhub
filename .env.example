# ── Database (Supabase) ────────────────────────────────────────────────
# Copy both from the Supabase dashboard: Connect -> ORMs, then replace
# [YOUR-PASSWORD] with your database password.
# DATABASE_URL -> pooled connection (port 6543), used at runtime
# DIRECT_URL   -> direct connection (port 5432), used by prisma migrate
DATABASE_URL=
DIRECT_URL=
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=true

# ── App ────────────────────────────────────────────────────────────────
# Public base URL. Webhook URLs shown in the trigger dialogs are built
# from this, so it MUST be your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth (Better Auth) ─────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Credential encryption ──────────────────────────────────────────────
# Encrypts stored API keys. Changing this makes existing credentials
# permanently undecryptable — keep it stable and back it up.
ENCRYPTION_KEY=

# ── Inngest ────────────────────────────────────────────────────────────
# Local only: points the SDK at the dev server on localhost:8288.
# Do NOT set this in production, or workflows will silently never run.
INNGEST_DEV=1
# Production only, from Inngest Cloud -> Manage -> Keys:
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ── Billing (Polar) ────────────────────────────────────────────────────
POLAR_ACCESS_TOKEN=
POLAR_SUCCESS_URL=http://localhost:3000/workflows

# ── Monitoring (Sentry) ────────────────────────────────────────────────
# Only needed to upload source maps during build.
SENTRY_AUTH_TOKEN=
